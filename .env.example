# ============================================
# ОБЯЗАТЕЛЬНЫЕ НАСТРОЙКИ
# ============================================

# Telegram Bot Token (ОБЯЗАТЕЛЬНО!)
# Получить у @BotFather: https://t.me/BotFather
# Пример: 1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_BOT_TOKEN=7410301345:AAGcXIHsOWuqVypqbtZk5izkPpLdGNU8y8M

# ============================================
# BINANCE API (Опционально)
# ============================================
# Бот использует публичный API Binance по умолчанию
# API ключи нужны только для приватных операций
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ============================================
# РЕЖИМ ТОРГОВЛИ
# ============================================
# swing - средне/долгосрочная торговля (5m свечи, проверка каждые 5 мин)
# day - внутридневная торговля (1m свечи, проверка каждую минуту)
TRADING_MODE=swing

# ============================================
# ML МОДЕЛЬ
# ============================================
# Использовать ML модель (true) или rule-based систему (false)
# Если true, нужно сначала обучить модель: python train.py
USE_ML_MODEL=false

# ============================================
# PRODUCTION НАСТРОЙКИ
# ============================================
# development или production
ENVIRONMENT=development

# Порт для healthcheck HTTP сервера
HEALTHCHECK_PORT=8080

# ============================================
# АЛЕРТЫ (Опционально)
# ============================================
# Telegram Chat ID для критичных алертов
# Узнать свой ID: @userinfobot
ALERT_TELEGRAM_CHAT_ID=

# ============================================
# ЛОГИРОВАНИЕ
# ============================================
# Уровень логов: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
